{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "musegod-fun",
  "account_id": "4b68bb6b6c38892162610027f25fbb0d",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "LAUNCHPAD",
        "class_name": "LaunchpadRuntime"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "LaunchpadRuntime"
      ]
    }
  ],
  "vars": {
    "CHAIN_MODE": "robinhood",
    "LIFI_INTEGRATOR": "musegodfun",
    "RUNTIME_SECURITY_PROTOCOL": "1",
    "SUPABASE_DATA_SCOPE": "robinhood",
    "PLATFORM_TREASURY": "0xc4F87C3715374445C4657aa14c47CBB339b59d1A",
    "FEE_ENGINE_ADDRESS": "0x9caefd217ea5a039BbA77Ae5b0626733eA093769",
    "ENABLE_MAINNET_TRANSACTIONS": "false",
    "ENABLE_BASE_TRANSACTIONS": "false",
    "ENABLE_ROBINHOOD_TRANSACTIONS": "true",
    "LAUNCH_GUARD_ADDRESS": "0xfD919E60eB32AE9d02A89D6D9bAB94E2634cDE29",
    "BASE_FIRST_BUY_GUARD_ADDRESS": "0x376DcBb32DF3B033547f3d9024b2e4E88b973BF7",
    "ROBINHOOD_FIRST_BUY_GUARD_ADDRESS": "0x531417dD153A72AA780DE27E502618a1F74AA409",
    "SUPABASE_URL": "https://vrhzgmulcyqqzkkforsl.supabase.co",
    "NODE_ENV": "production"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "routes": [
    {
      "pattern": "musegod.fun/*",
      "zone_id": "13efa20023853aca22c7d76fa60475cf"
    },
    {
      "pattern": "www.musegod.fun/*",
      "zone_id": "13efa20023853aca22c7d76fa60475cf"
    }
  ]
}
