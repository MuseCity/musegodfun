# Node 24.11+. Server-only secrets; never use VITE_ prefixes or commit .env.
PORT=5188
CHAIN_MODE=robinhood
ALCHEMY_API_KEY=
COINGECKO_API_KEY=
# Public IPFS image uploads use the server-only Pinata JWT (v3 Files API).
PINATA_JWT=
# Alchemy takes priority. BASE_RPC_URL is used only when ALCHEMY_API_KEY is absent.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
BASE_RPC_URL=https://mainnet.base.org
PLATFORM_TREASURY=
# Explicit opt-in for user-confirmed issuance, approvals, swaps and fee claims.
# The server RPC remains read-only; buyback execution is deferred.
ENABLE_MAINNET_TRANSACTIONS=false
# Optional immutable launch guard. Served only after compiled runtime/dependency verification.
LAUNCH_GUARD_ADDRESS=
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=
# Optional direct database URL for administration; runtime uses the HTTPS API above.
SUPABASE_DB_URL=
SUPABASE_DATA_SCOPE=robinhood
# Fork/tests only: isolated SQLite directory; never shared with production Supabase.
FORK_CHAIN_ID=4663
FORK_RPC_URL=http://127.0.0.1:8547
DATA_DIR=.data/fork
