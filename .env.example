# Node 24.11+. Server-only secrets; never use VITE_ prefixes or commit .env.
PORT=5188
CHAIN_MODE=robinhood
ALCHEMY_API_KEY=
COINGECKO_API_KEY=
# Public IPFS image uploads use the server-only Pinata JWT (v3 Files API).
PINATA_JWT=
# Alchemy takes priority for chain reads, buyback statistics and the secondary RPC.
# Chain RPC URLs below are used only when ALCHEMY_API_KEY is absent.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
BASE_RPC_URL=https://mainnet.base.org
# Operations recipient: must match constants.treasury in buyback.config.json.
# Unpriced buyback fees use the separate Splits constants.automation smart account.
PLATFORM_TREASURY=
# Explicit opt-in for user-confirmed issuance, approvals, swaps and fee claims.
# The server RPC remains read-only. This existing flag controls Robinhood; Base bridging remains deferred.
ENABLE_MAINNET_TRANSACTIONS=false
# Base has independent opt-in; never inherits the Robinhood signing flag.
ENABLE_BASE_TRANSACTIONS=false
# Optional explicit Robinhood override of ENABLE_MAINNET_TRANSACTIONS:
# ENABLE_ROBINHOOD_TRANSACTIONS=false
# Optional immutable launch guard. Served only after compiled runtime/dependency verification.
LAUNCH_GUARD_ADDRESS=
# Separate optional vesting-capable guard candidates; no mainnet V2 address is deployed yet.
BASE_LAUNCH_GUARD_ADDRESS=
BASE_FIRST_BUY_GUARD_ADDRESS=
ROBINHOOD_FIRST_BUY_GUARD_ADDRESS=
# LI.FI opening references and same-chain payment conversion. API key is private; integrator is public.
LIFI_INTEGRATOR=musegodfun
LIFI_API_KEY=
# Optional public fee engine. Enabled only against the verified deployment manifest.
FEE_ENGINE_ADDRESS=
# One-time local CLI deployment signer; never configure this in a Worker or send it in chat.
MUSEGOD_DEPLOY_PRIVATE_KEY=
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=
# Optional direct database URL for administration; runtime uses the HTTPS API above.
SUPABASE_DB_URL=
# Admin/verification scripts only; dual-chain Web scopes stay canonical base/robinhood.
SUPABASE_DATA_SCOPE=robinhood
# Fork/tests only: isolated SQLite directory; never shared with production Supabase.
FORK_CHAIN_ID=4663
FORK_RPC_URL=http://127.0.0.1:8547
DATA_DIR=.data/fork
# Dedicated optional keeper account. CLI stays dry-run unless --execute is supplied.
# Never reuse PLATFORM_TREASURY or MUSEGOD_DEPLOY_PRIVATE_KEY. Never put this key in chat.
MUSEGOD_KEEPER_PRIVATE_KEY=
